# Two different DNS A/AAAA records pointing at this server.
MESH_API_HOST=api.mesh.example.com
MESH_RELAY_HOST=relay.mesh.example.com
ACME_EMAIL=operations@example.com

# Edge and application limits. Relay transfer bytes are not throttled.
MESH_API_RATE_LIMIT_PER_MINUTE=600
MESH_PAIRING_RATE_LIMIT_PER_MINUTE=10
MESH_RELAY_CONNECTS_PER_MINUTE=6000
MESH_RELAY_CONNECTS_PER_NODE_PER_MINUTE=600

# Capacity and monitoring retention.
MESH_RELAY_MAX_WAITING=1024
MESH_RELAY_MAX_ACTIVE=512
PROMETHEUS_RETENTION=15d
