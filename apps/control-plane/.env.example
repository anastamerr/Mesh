# Copy to .env in this directory. Generate a random admin key, do not reuse this text.
DATABASE_URL=postgresql://mesh:mesh_local_only@localhost:5432/mesh
MESH_ADMIN_KEY=replace-with-at-least-32-random-characters
HOST=127.0.0.1
PORT=3000
# Optional remote storage: set both, using a separate random relay service key.
# MESH_RELAY_ORIGIN=https://relay.example:7443
# MESH_RELAY_KEY=replace-with-a-separate-random-service-key
