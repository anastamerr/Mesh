* text=auto

# Go formatting is byte-sensitive. Keep sources LF even on Windows runners.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# Scripts, workflows, and container inputs execute on Linux.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# The guided installer is a native Windows script.
*.ps1 text eol=crlf
